# Base URL of the API. Leave empty in development: Vite proxies /api and /uploads to localhost:4000.
# In production set it to the deployed API origin, e.g. https://throughmytrails-api.onrender.com
VITE_API_URL=

# Public URL of this site, used for canonical and Open Graph tags.
VITE_SITE_URL=http://localhost:5173
