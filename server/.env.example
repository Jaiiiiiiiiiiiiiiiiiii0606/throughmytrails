PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/throughmytrails

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated allow-list for CORS. The first entry is used for links in emails (admin panel URL).
CLIENT_URL=http://localhost:5173

# The admin account created automatically on first start (and by `npm run seed`).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Nachiket R. Patil
ADMIN_NOTIFY_EMAIL=throughmytrails@gmail.com

# smtp (Nodemailer, below) or brevo (HTTPS API; use on hosts that block SMTP, e.g. Render's free plan)
MAIL_TRANSPORT=smtp
BREVO_API_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=throughmytrails@gmail.com
SMTP_PASS=            # Gmail App Password, not the normal password
MAIL_FROM="Through My Trails <throughmytrails@gmail.com>"

# disk (UPLOAD_DIR) or mongo (GridFS; use on hosts without a persistent disk)
UPLOAD_STORAGE=disk
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Reverse-proxy hops to trust for the client IP (1 behind Nginx/Render alone; "true" behind Vercel's proxy).
TRUST_PROXY=0
# lax when the website proxies /api (same origin); none if the website calls the API on another domain.
COOKIE_SAMESITE=lax
