PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/throughmytrails

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated allow-list for CORS. The first entry is used for links in emails (admin panel URL).
CLIENT_URL=http://localhost:5173

# The admin account created automatically on first start (and by `npm run seed`).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Nachiket R. Patil
ADMIN_NOTIFY_EMAIL=throughmytrails@gmail.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=throughmytrails@gmail.com
SMTP_PASS=            # Gmail App Password, not the normal password
MAIL_FROM="Through My Trails <throughmytrails@gmail.com>"

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# Hover clips and ambient sounds for destinations.
MAX_VIDEO_MB=40
MAX_AUDIO_MB=10

# Traveller sign-in. Email codes always work; leave these empty to hide the Google / Apple buttons.
# Google: OAuth 2.0 "Web application" client id (see README).
GOOGLE_CLIENT_ID=
# Apple: your Services ID (e.g. com.throughmytrails.web) and its registered return URL.
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=

# Set to 1 when running behind a reverse proxy (Render, Railway, Nginx) so rate limiting sees the real client IP.
TRUST_PROXY=1
