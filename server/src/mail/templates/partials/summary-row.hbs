{{!-- One label/value row in a summary card. Params: label, value --}}
<tr>
  <td width="38%" valign="top" style="padding:9px 0; border-bottom:1px dashed #D2C0A3; font-family:'Jost', 'Helvetica Neue', Arial, sans-serif; font-size:11px; font-weight:600; letter-spacing:1.6px; text-transform:uppercase; color:#6B4E35;">{{label}}</td>
  <td valign="top" style="padding:9px 0; border-bottom:1px dashed #D2C0A3; font-family:'Jost', 'Helvetica Neue', Arial, sans-serif; font-size:15px; line-height:21px; color:#2E2219;">{{value}}</td>
</tr>
