{{!-- Bulletproof pill button. Params: href, label, dark (bool) --}}
<table role="presentation" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td align="center" bgcolor="{{#if dark}}#2E2219{{else}}#FBF7F0{{/if}}" style="border-radius:999px; {{#unless dark}}border:1.5px solid #2E2219;{{/unless}}">
      <a href="{{href}}" target="_blank" style="display:inline-block; padding:14px 28px; font-family:'Jost', 'Helvetica Neue', Arial, sans-serif; font-size:15px; font-weight:500; letter-spacing:0.5px; line-height:20px; text-decoration:none; border-radius:999px; color:{{#if dark}}#F7F1E7{{else}}#2E2219{{/if}};">{{label}}</a>
    </td>
  </tr>
</table>
