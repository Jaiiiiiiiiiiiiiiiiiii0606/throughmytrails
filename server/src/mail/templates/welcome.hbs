{{!--
  Sent once, when a traveller creates an account (email code, Google or Apple).
  Variables: firstName, planUrl, exploreUrl, accountUrl, whatsappUrl, perks[{icon,title,text}], contact.*
--}}
{{#> layout}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td class="px" style="padding:40px 44px 8px 44px;">
      <p style="margin:0 0 6px 0; font-family:'Jost', 'Helvetica Neue', Arial, sans-serif; font-size:11px; font-weight:500; letter-spacing:3px; text-transform:uppercase; color:#6B4E35;">Welcome aboard</p>
      <h1 class="h1" style="margin:0 0 18px 0; font-family:'Cormorant Garamond', Georgia, 'Times New Roman', serif; font-size:36px; line-height:40px; font-weight:600; color:#2E2219;">Hi {{firstName}}, <span style="font-style:italic; color:#8A6440;">your trail starts here.</span></h1>
      <p style="margin:0 0 16px 0; font-family:'Jost', 'Helvetica Neue', Arial, sans-serif; font-size:16px; line-height:26px; color:#4A3A2C;">
        Thank you for joining Through My Trails. Your account is ready. From now on, every trip you plan with us, from the first idea to the final boarding pass, lives in one place.
      </p>
    </td>
  </tr>

  <tr>
    <td class="px" style="padding:12px 44px 8px 44px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F1E7D7; border-radius:20px;">
        <tr>
          <td style="padding:24px 26px 10px 26px;">
            <p style="margin:0 0 14px 0; font-family:'Cormorant Garamond', Georgia, 'Times New Roman', serif; font-size:24px; line-height:30px; font-weight:600; color:#2E2219;">What you can do now</p>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              {{#each perks}}
              <tr>
                <td width="44" valign="top" style="padding:0 0 16px 0;">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
                    <td align="center" valign="middle" width="32" height="32" style="width:32px; height:32px; border-radius:16px; background-color:#2E2219; font-family:'Jost', Arial, sans-serif; font-size:15px; color:#F7F1E7;">{{this.icon}}</td>
                  </tr></table>
                </td>
                <td valign="top" style="padding:4px 0 16px 0; font-family:'Jost', 'Helvetica Neue', Arial, sans-serif; font-size:15px; line-height:23px; color:#4A3A2C;">
                  <strong style="color:#2E2219; font-weight:500;">{{this.title}}.</strong> {{this.text}}
                </td>
              </tr>
              {{/each}}
            </table>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <tr>
    <td class="px" style="padding:22px 44px 8px 44px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td class="btn-cell" style="padding:0 12px 0 0;">{{> button href=planUrl label="Plan my first trip" dark=true}}</td>
          <td class="btn-cell">{{> button href=exploreUrl label="Explore destinations" dark=false}}</td>
        </tr>
      </table>
    </td>
  </tr>

  <tr>
    <td class="px" style="padding:22px 44px 40px 44px;">
      <p style="margin:0 0 14px 0; font-family:'Jost', 'Helvetica Neue', Arial, sans-serif; font-size:14px; line-height:22px; color:#4A3A2C;">
        Rather talk it through? <a href="{{whatsappUrl}}" style="color:#5A4330;">Message us on WhatsApp</a> and a real planner will reply.
      </p>
      <p style="margin:0; font-family:'Allura', 'Snell Roundhand', 'Apple Chancery', 'Brush Script MT', 'Segoe Script', cursive; font-size:32px; line-height:38px; color:#5A4330;">See you on the trail <span style="color:#A67C4E;">&#9829;</span></p>
      <p style="margin:6px 0 0 0; font-family:'Jost', 'Helvetica Neue', Arial, sans-serif; font-size:13px; font-weight:500; letter-spacing:2px; text-transform:uppercase; color:#6B4E35;">— Nachiket &amp; Team Through My Trails</p>
    </td>
  </tr>
</table>
{{/layout}}
