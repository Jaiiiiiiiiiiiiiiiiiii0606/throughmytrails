{{!-- Sent from Admin → Settings → "Send a test email". Variables: sentAt, sentBy --}}
{{#> layout}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td class="px" style="padding:40px 44px 40px 44px;">
      <p style="margin:0 0 6px 0; font-family:'Jost', 'Helvetica Neue', Arial, sans-serif; font-size:11px; font-weight:500; letter-spacing:3px; text-transform:uppercase; color:#6B4E35;">Test email</p>
      <h1 class="h1" style="margin:0 0 16px 0; font-family:'Cormorant Garamond', Georgia, 'Times New Roman', serif; font-size:34px; line-height:38px; font-weight:600; color:#2E2219;">Your email is <span style="font-style:italic; color:#8A6440;">ready for take-off.</span></h1>
      <p style="margin:0 0 12px 0; font-family:'Jost', 'Helvetica Neue', Arial, sans-serif; font-size:16px; line-height:26px; color:#4A3A2C;">
        If you are reading this, Through My Trails can send enquiry confirmations and new-enquiry alerts.
      </p>
      <p style="margin:0; font-family:'Jost', 'Helvetica Neue', Arial, sans-serif; font-size:13px; line-height:20px; color:#6B4E35;">Sent {{sentAt}} by {{sentBy}}.</p>
    </td>
  </tr>
</table>
{{/layout}}
